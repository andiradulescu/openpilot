#!/bin/sh

default_script=${UDHCPC_DEFAULT_SCRIPT:-/etc/udhcpc/default.script}
wifi_route_metric=600

"$default_script" "$1" || exit $?

case "$1" in
  bound|renew)
    gateway=${router%% *}
    if [ -z "$gateway" ]; then
      gateway=$(ip -4 route show default dev "$interface" | awk '$1 == "default" { for (i = 1; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }') || exit $?
    fi
    [ -n "$gateway" ] || exit 1
    ip -4 route flush default dev "$interface" || exit $?
    ip -4 route replace default via "$gateway" dev "$interface" metric "$wifi_route_metric" || exit $?
    ;;
esac
