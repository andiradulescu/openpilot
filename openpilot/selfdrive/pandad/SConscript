import libusb

Import('env', 'arch', 'common', 'messaging')

if arch == "Darwin":
  panda_env = env.Clone()
  panda_env['CPPPATH'] += [libusb.INCLUDE_DIR]
  panda_env['LIBPATH'] += [libusb.LIB_DIR]
  panda_env['FRAMEWORKS'] = ['IOKit', 'CoreFoundation', 'Security']
  libs = [common, messaging, 'pthread']
  panda = panda_env.Library('panda', ['panda.cc', 'panda_comms.cc'])

  panda_env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs + ['usb-1.0'])

  if GetOption('extras'):
    panda_env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs + ['usb-1.0'])
    panda_env.Program('tests/test_pandad_usb_transport', ['tests/test_pandad_usb_transport.cc'], LIBS=[panda] + libs + ['usb-1.0'])
else:
  libs = [common, messaging, 'pthread']
  panda = env.Library('panda', ['panda.cc', 'spi.cc'])

  env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

  if GetOption('extras'):
    env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs)
